    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "babel-preset-expo": "~58.0.0",
    "clsx": "2.1.1",
    "expo": "^58.0.17",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
